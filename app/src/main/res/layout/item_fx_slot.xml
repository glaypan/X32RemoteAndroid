<?xml version="1.0" encoding="utf-8"?>
<!-- 效果器机架的一行：一个 FX 槽。
     8 行固定，不做自绘（ChannelStripView 那套自绘是为 48 路长列表准备的）。
     v1.8 起在文字行下面加一条真机面板截图，认算法靠它。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSlot"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="FX 1"
            android:textColor="#8A94A6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAlgo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="—"
                android:textColor="#E8EDF5"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#8A94A6"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="OFF"
            android:textColor="#8A94A6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#4AA8FF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- 真机面板截图：480×134 的宽条，等比缩放；空槽/未知算法时 GONE -->
    <ImageView
        android:id="@+id/ivPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:background="#0D0F13"
        android:contentDescription="效果器真机面板"
        android:scaleType="fitCenter"
        android:visibility="gone" />

</LinearLayout>
